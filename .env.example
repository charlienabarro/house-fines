# Copy this file to .env.local and fill in the values.
# Supabase Dashboard -> Project Settings -> API Keys (and Data API for the URL).

# Safe to expose to the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects show an "anon" key instead. Either works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SECRET. Only used by `npm run seed` to create accounts. Never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Older projects call this the service_role key:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Usernames are turned into placeholder emails: <username>@MEMBER_EMAIL_DOMAIN
# Must match between the seed script and the app.
MEMBER_EMAIL_DOMAIN=housefines.local
